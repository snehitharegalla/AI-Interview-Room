# ===============================================
# AI INTERVIEW ROOM - ENVIRONMENT CONFIGURATION
# ===============================================

# AI Provider: "gemini", "openai", or "mock"
# If set to "gemini" or "openai" without valid keys, it safely falls back to the intelligent "mock" demo engine.
AI_PROVIDER=mock

# Gemini API Key (Required if AI_PROVIDER=gemini)
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Model overrides (Optional)
# Gemini: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
# OpenAI: gpt-4o-mini, gpt-4o
AI_MODEL=gemini-1.5-flash

# Database Configuration (SQLite default for easy local zero-config setup)
DATABASE_URL=sqlite:///./interview_room.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
